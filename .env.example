DATABASE_URL="postgresql://nexus:nexus_development_only@localhost:5432/nexus_tax?schema=public"
APP_ENV="development"
# Required in production; use at least 32 random characters to key pre-session attempt hashes.
AUTH_RATE_LIMIT_SECRET="replace-with-at-least-32-random-characters"
# Supabase Auth provider. The NEXT_PUBLIC values intentionally contain only the
# provider URL and publishable key; never expose a service-role key.
SUPABASE_URL="https://project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace-me"
NEXT_PUBLIC_SUPABASE_URL="https://project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace-me"
# Base64 for exactly 32 random bytes used only for five-minute MFA flow cookies.
NEXUS_AUTH_FLOW_KEY="replace-with-a-base64-encoded-32-byte-key"
# Header overwritten by the trusted ingress proxy with one client IP address.
NEXUS_TRUSTED_NETWORK_HEADER="x-real-ip"
NEXUS_AUTH_RECOVERY_REDIRECT_URL="https://tax.example.com/auth/recovery/confirm"
# Optional for a single-firm pilot. Multi-firm users may select an authorized firm at login.
NEXUS_AUTH_DEFAULT_FIRM_ID=""
# Optional development-only seeded identity selectors. Production ignores fallback identity.
NEXUS_DEV_USER_ID="20000000-0000-4000-8000-000000000001"
NEXUS_DEV_FIRM_ID="10000000-0000-4000-8000-000000000001"
# Required in production for source uploads. The endpoint accepts raw bytes over HTTPS
# and returns {"clean":boolean,"scannerVersion":string,"reason"?:string}.
NEXUS_MALWARE_SCANNER_URL="https://scanner.example.invalid/v1/scan"
NEXUS_MALWARE_SCANNER_TOKEN="replace-with-at-least-32-random-characters"
# Required in production; base64 for exactly 32 random bytes used by AES-256-GCM.
NEXUS_SOURCE_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"
# Production readiness evidence references and accountable owners.
NEXUS_MONITORING_PROVIDER=""
NEXUS_INCIDENT_OWNER=""
NEXUS_SECURITY_OWNER=""
NEXUS_PRODUCT_OWNER=""
NEXUS_SCOPE_APPROVAL_REF=""
NEXUS_TAX_RULE_OWNER=""
NEXUS_TAX_RULE_APPROVAL_REF=""
NEXUS_RETENTION_POLICY_REF=""
NEXUS_PRODUCTION_DATA_AUTHORIZATION_REF=""
NEXUS_BACKUP_PROVIDER=""
NEXUS_BACKUP_RPO_MINUTES="60"
NEXUS_BACKUP_RTO_MINUTES="240"
NEXUS_BACKUP_RESTORE_EVIDENCE_REF=""
