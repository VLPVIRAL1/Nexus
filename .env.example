DATABASE_URL="postgresql://nexus:nexus_development_only@localhost:5432/nexus_tax?schema=public"
APP_ENV="development"
# Required in production; use at least 32 random characters to key pre-session attempt hashes.
AUTH_RATE_LIMIT_SECRET="replace-with-at-least-32-random-characters"
# Optional development-only seeded identity selectors. Production ignores fallback identity.
NEXUS_DEV_USER_ID="20000000-0000-4000-8000-000000000001"
NEXUS_DEV_FIRM_ID="10000000-0000-4000-8000-000000000001"
