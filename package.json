{
  "name": "nexus-tax",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:prisma:migrate": "prisma migrate dev",
    "worker:artifacts": "node --conditions=react-server --import tsx scripts/artifact-worker.ts",
    "recovery:exercise": "tsx scripts/recovery-exercise.ts",
    "performance:exercise": "tsx scripts/performance-exercise.ts",
    "auth:link": "tsx scripts/link-external-identity.ts",
    "readiness:production": "tsx scripts/production-readiness.ts",
    "diagnostics:generate": "tsx scripts/generate-diagnostic-manifest.ts",
    "diagnostics:check": "tsx scripts/generate-diagnostic-manifest.ts --check",
    "hostinger:build": "npm run db:migrate && npm run readiness:production && npm run build",
    "hostinger:start": "node scripts/hostinger-runtime.mjs",
    "acceptance:technical": "npm run diagnostics:check && npm run db:migrate && npm run db:seed && npm run typecheck && npm test && npm run test:integration && npm run build && CI=true npm run test:e2e && npm audit --audit-level=high && npm run recovery:exercise && npm run performance:exercise"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "6.12.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-table": "8.21.3",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "lucide-react": "0.468.0",
    "next": "16.3.8",
    "pdf-lib": "1.17.1",
    "pg": "8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "7.63.0",
    "server-only": "0.0.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "24.7.0",
    "@types/pg": "8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "prisma": "6.12.0",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "@tailwindcss/oxide@4.1.14": true,
    "esbuild@0.25.12": true,
    "prisma@6.12.0": true
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
