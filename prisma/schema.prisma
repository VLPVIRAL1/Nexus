generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  PREPARER
  REVIEWER
  READ_ONLY
}

enum PreparationStatus {
  NOT_STARTED
  DOCUMENTS_PENDING
  IN_PREPARATION
  READY_FOR_REVIEW
  CHANGES_REQUESTED
  REVIEWED_DRAFT
  ARCHIVED
}

model Firm {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  memberships Membership[]
  clients     Client[]
  authSessions AuthSession[]
  createdAt   DateTime     @default(now())
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  email       String       @unique
  displayName String
  memberships Membership[]
  assignments ClientAssignment[]
  auditEvents AuditEvent[]
  authSessions AuthSession[]
  importAttempts ImportAttempt[]
  externalIdentities ExternalIdentity[]
  committedImports ImportBatch[] @relation("CommittedImports")
  rolledBackImports ImportBatch[] @relation("RolledBackImports")
  expectedDocuments ExpectedDocument[]
  completenessAttestations CompletenessAttestation[]
  createdAt   DateTime     @default(now())
}

model ExternalIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  providerCode    String   @map("provider_code")
  providerSubject String   @map("provider_subject")
  userId          String   @map("user_id") @db.Uuid
  linkedEmail     String?  @map("linked_email")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  @@unique([providerCode, providerSubject])
  @@unique([providerCode, userId])
  @@map("external_identities")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  firmId    String   @db.Uuid
  userId    String   @db.Uuid
  role      RoleName
  firm      Firm     @relation(fields: [firmId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@unique([firmId, userId])
}

model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid
  tokenHash         String    @unique
  userId            String    @db.Uuid
  activeFirmId      String    @db.Uuid
  mfaVerifiedAt     DateTime
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  revocationReason  String?
  userAgentHash     String?
  user              User      @relation(fields: [userId], references: [id])
  activeFirm        Firm      @relation(fields: [activeFirmId], references: [id])
  @@index([userId, activeFirmId, absoluteExpiresAt])
}

model Client {
  id          String    @id @default(uuid()) @db.Uuid
  firmId      String    @db.Uuid
  clientCode  String
  displayName String
  archivedAt  DateTime?
  version     Int       @default(1)
  firm        Firm      @relation(fields: [firmId], references: [id])
  taxYears    TaxYear[]
  assignments ClientAssignment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@unique([firmId, clientCode])
  @@index([firmId, displayName])
}

model TaxYear {
  id                String            @id @default(uuid()) @db.Uuid
  clientId          String            @db.Uuid
  year              Int
  revision          Int               @default(1)
  status            PreparationStatus @default(NOT_STARTED)
  canonicalSnapshot Json
  client            Client            @relation(fields: [clientId], references: [id])
  sourceDocuments   SourceDocument[]
  people            Person[]
  dependents        Dependent[]
  sourceForms       SourceFormRecord[]
  activities        Activity[]
  sourceMappings    SourceMapping[]
  importBatches     ImportBatch[]
  importAttempts    ImportAttempt[]
  expectedDocuments ExpectedDocument[]
  completenessAttestations CompletenessAttestation[]
  validationIssues  ValidationIssue[]
  reviewPoints      ReviewPoint[]
  manualOverrides   ManualOverride[]
  generatedForms    GeneratedForm[]
  returnPackages    GeneratedReturnPackage[]
  workpaperRuns     WorkpaperRun[]
  calculationRuns   CalculationRun[]
  generatedArtifacts GeneratedArtifact[]
  auditEvents       AuditEvent[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  @@unique([clientId, year])
}

model SourceDocument {
  id                   String   @id @default(uuid()) @db.Uuid
  taxYearId            String   @db.Uuid
  fileName             String
  documentType         String
  storageId            String?
  mimeType             String?
  byteLength           BigInt?
  checksum             String?
  pageCount            Int?
  duplicateFingerprint String?
  disposition          String   @default("original")
  supersedesDocumentId String?  @db.Uuid
  scanState            String   @default("pending")
  storageVersion       Int      @default(1)
  uploadedById         String?  @db.Uuid
  scannerVersion       String?
  scanCompletedAt      DateTime?
  uploadedAt           DateTime @default(now())
  taxYear              TaxYear  @relation(fields: [taxYearId], references: [id])
  sourceForms          SourceFormRecord[]
  expectedDocuments ExpectedDocument[]
  @@index([taxYearId, duplicateFingerprint])
}

model SourceObjectBlob {
  id              String   @id @default(uuid()) @db.Uuid
  objectKey       String   @unique
  storageVersion  Int      @default(1)
  objectState     String
  cipherAlgorithm String   @default("aes-256-gcm")
  cipherIv        Bytes
  cipherAuthTag   Bytes
  cipherBytes     Bytes
  createdAt       DateTime @default(now())
  promotedAt      DateTime?
  @@index([objectState, createdAt])
}

model ExpectedDocument {
  id               String          @id @default(uuid()) @db.Uuid
  taxYearId        String          @db.Uuid
  documentKey      String
  label            String
  status           String
  evidence         String?
  sourceDocumentId String?         @db.Uuid
  version          Int             @default(1)
  updatedById      String          @db.Uuid
  taxYear          TaxYear         @relation(fields: [taxYearId], references: [id])
  sourceDocument   SourceDocument? @relation(fields: [sourceDocumentId], references: [id])
  updatedBy        User            @relation(fields: [updatedById], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  @@unique([taxYearId, documentKey])
}

model CompletenessAttestation {
  id                         String   @id @default(uuid()) @db.Uuid
  taxYearId                  String   @db.Uuid
  taxYearRevision            Int
  attestedById               String   @db.Uuid
  evidence                   String
  missingDocumentExplanation String?
  taxYear                    TaxYear  @relation(fields: [taxYearId], references: [id])
  attestedBy                 User     @relation(fields: [attestedById], references: [id])
  createdAt                  DateTime @default(now())
  @@unique([taxYearId, taxYearRevision])
  @@index([taxYearId, taxYearRevision])
}

model ClientAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @db.Uuid
  userId    String   @db.Uuid
  kind      String
  client    Client   @relation(fields: [clientId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@unique([clientId, userId, kind])
}

model Person {
  id             String   @id @default(uuid()) @db.Uuid
  taxYearId      String   @db.Uuid
  role           String
  legalName      String
  tinEncrypted   String?
  dateOfBirth    DateTime? @db.Date
  address        Json
  facts          Json
  version        Int      @default(1)
  taxYear        TaxYear  @relation(fields: [taxYearId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([taxYearId, role])
}

model Dependent {
  id             String   @id @default(uuid()) @db.Uuid
  taxYearId      String   @db.Uuid
  legalName      String
  tinEncrypted   String?
  facts          Json
  version        Int      @default(1)
  taxYear        TaxYear  @relation(fields: [taxYearId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SourceFormRecord {
  id                 String          @id @default(uuid()) @db.Uuid
  taxYearId          String          @db.Uuid
  sourceDocumentId   String?         @db.Uuid
  importBatchId      String?         @db.Uuid
  formType           String
  formYear           Int
  externalSourceId   String?
  ownerRole          String
  ownerPersonId      String?         @db.Uuid
  normalizedData     Json
  rawFields          Json
  unmappedFields     Json
  corrected          Boolean         @default(false)
  void               Boolean         @default(false)
  effective          Boolean         @default(true)
  recordDisposition  String          @default("original")
  changeReason       String?
  createdById        String?         @db.Uuid
  supersedesRecordId String?         @db.Uuid
  version            Int             @default(1)
  taxYear            TaxYear         @relation(fields: [taxYearId], references: [id])
  sourceDocument     SourceDocument? @relation(fields: [sourceDocumentId], references: [id])
  importBatch        ImportBatch?     @relation(fields: [importBatchId], references: [id])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  @@unique([taxYearId, externalSourceId, version])
  @@index([taxYearId, formType, effective])
}

model Activity {
  id                   String          @id @default(uuid()) @db.Uuid
  taxYearId            String          @db.Uuid
  type                 String
  name                 String
  ownerRole            String
  implementationStatus String
  receiptBasis         String?
  additionalReceipts   Decimal         @default(0) @db.Decimal(18, 2)
  receiptNote          String?
  details              Json
  active               Boolean         @default(true)
  version              Int             @default(1)
  taxYear              TaxYear         @relation(fields: [taxYearId], references: [id])
  mappings             SourceMapping[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model SourceMapping {
  id               String    @id @default(uuid()) @db.Uuid
  taxYearId        String    @db.Uuid
  sourceRecordId   String    @db.Uuid
  sourceField      String
  sourceAmount     Decimal   @db.Decimal(18, 2)
  targetType       String
  targetActivityId String?   @db.Uuid
  allocationMethod String
  allocatedAmount  Decimal   @db.Decimal(18, 2)
  percentage       Decimal?  @db.Decimal(7, 4)
  reason           String?
  status           String
  version          Int       @default(1)
  effective        Boolean   @default(true)
  supersedesMappingId String? @db.Uuid
  note             String?
  createdById      String?   @db.Uuid
  receivesRoundingResidual Boolean @default(false)
  taxYear          TaxYear   @relation(fields: [taxYearId], references: [id])
  targetActivity   Activity? @relation(fields: [targetActivityId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  @@index([taxYearId, sourceRecordId, sourceField])
}

model ImportBatch {
  id             String               @id @default(uuid()) @db.Uuid
  taxYearId      String               @db.Uuid
  fileName       String
  schemaVersion  String
  batchHash      String
  baseRevision   Int
  status         String
  rawStorageId   String?
  previewId      String?              @unique @db.Uuid
  rawPayload     Bytes?
  parsedPayload  Json?
  previousSnapshot Json?
  committedSnapshot Json?
  committedById String?               @db.Uuid
  rolledBackAt  DateTime?
  rolledBackById String?              @db.Uuid
  resultRevision Int?
  summary        Json
  taxYear        TaxYear              @relation(fields: [taxYearId], references: [id])
  changes        ImportRecordChange[]
  attempts       ImportAttempt[]
  sourceForms    SourceFormRecord[]
  committedBy    User?                @relation("CommittedImports", fields: [committedById], references: [id])
  rolledBackBy   User?                @relation("RolledBackImports", fields: [rolledBackById], references: [id])
  createdAt      DateTime             @default(now())
  committedAt    DateTime?
  @@unique([taxYearId, batchHash])
}

model ImportRecordChange {
  id            String      @id @default(uuid()) @db.Uuid
  importBatchId String      @db.Uuid
  fieldPath     String
  changeId      String?     @unique @db.Uuid
  pathSegments  Json
  changeKind    String
  existingValue Json?
  importedValue Json?
  decision      String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id])
}

model ImportAttempt {
  id            String       @id @default(uuid()) @db.Uuid
  taxYearId     String       @db.Uuid
  importBatchId String?      @db.Uuid
  batchHash     String
  attemptedById String       @db.Uuid
  outcome       String
  taxYear       TaxYear      @relation(fields: [taxYearId], references: [id])
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])
  attemptedBy   User         @relation(fields: [attemptedById], references: [id])
  createdAt     DateTime     @default(now())
  @@index([taxYearId, batchHash, createdAt])
}

model ValidationIssue {
  id               String   @id @default(uuid()) @db.Uuid
  taxYearId        String   @db.Uuid
  code             String
  severity         String
  category         String
  recordId         String?
  fieldPath        String?
  message          String
  resolutionAction String
  creationRevision Int
  resolvedRevision Int?
  resolution       String?
  taxYear          TaxYear  @relation(fields: [taxYearId], references: [id])
  createdAt        DateTime @default(now())
  resolvedAt       DateTime?
  @@index([taxYearId, severity, resolvedAt])
}

model ReviewPoint {
  id            String   @id @default(uuid()) @db.Uuid
  taxYearId     String   @db.Uuid
  category      String
  subject       String
  description   String
  status        String
  sourceRecordId String?
  relatedForm   String?
  relatedActivityId String?
  assignedUserId String? @db.Uuid
  createdById   String   @db.Uuid
  dueDate       DateTime? @db.Date
  resolution    String?
  resolvedById  String?  @db.Uuid
  creationRevision Int
  ownerRole     String?
  version       Int      @default(1)
  resolutionRevision Int?
  dependencyHash String  @default("")
  taxYear       TaxYear  @relation(fields: [taxYearId], references: [id])
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?
}

model ManualOverride {
  id              String   @id @default(uuid()) @db.Uuid
  taxYearId       String   @db.Uuid
  overridePoint   String
  engineValue     Decimal  @db.Decimal(18, 2)
  overrideValue   Decimal  @db.Decimal(18, 2)
  unit            String
  reason          String
  evidence        String
  actorId         String   @db.Uuid
  approvedById    String?  @db.Uuid
  active          Boolean  @default(false)
  creationRevision Int
  calculationRunId String? @db.Uuid
  status          String   @default("pending_review")
  version         Int      @default(1)
  dependencyHash  String   @default("")
  downstreamPaths Json
  approvedAt      DateTime?
  rejectedById    String?  @db.Uuid
  rejectedAt      DateTime?
  reviewNote      String?
  revertedById    String?  @db.Uuid
  revertedAt      DateTime?
  supersedesOverrideId String? @db.Uuid
  taxYear         TaxYear  @relation(fields: [taxYearId], references: [id])
  createdAt       DateTime @default(now())
}

model CalculationRun {
  id                  String   @id @default(uuid()) @db.Uuid
  taxYearId           String   @db.Uuid
  inputRevision       Int
  inputHash           String
  engineVersion       String
  ruleVersion         String
  formRegistryVersion String
  status              String
  result              Json
  inputSnapshot       Json
  requestedById       String?  @db.Uuid
  resultHash          String?
  completedAt         DateTime?
  taxYear             TaxYear  @relation(fields: [taxYearId], references: [id])
  createdAt           DateTime @default(now())
  generatedForms      GeneratedForm[]
  returnPackages      GeneratedReturnPackage[]
  workpapers          WorkpaperRun[]
  generatedArtifacts GeneratedArtifact[]
  @@index([taxYearId, createdAt])
}

model GeneratedArtifact {
  id               String         @id @default(uuid()) @db.Uuid
  taxYearId        String         @db.Uuid
  calculationRunId String?        @db.Uuid
  artifactType     String
  artifactKey      String
  templateVersion  String?
  status           String
  completeness     String
  storageId        String?
  contentHash      String?
  manifest         Json
  artifactBytes    Bytes?
  mimeType         String?
  fileName         String?
  createdById      String?        @db.Uuid
  idempotencyKey   String?        @unique
  errorMessage     String?
  attemptCount     Int            @default(1)
  staleAt          DateTime?
  taxYear          TaxYear        @relation(fields: [taxYearId], references: [id])
  calculationRun   CalculationRun? @relation(fields: [calculationRunId], references: [id])
  createdAt        DateTime       @default(now())
  @@index([taxYearId, artifactType, createdAt])
}

model GeneratedForm {
  id              String          @id @default(uuid()) @db.Uuid
  taxYearId       String          @db.Uuid
  calculationRunId String         @db.Uuid
  formKey         String
  taxYearRevision String
  templateVersion String
  status          String
  completeness    String
  storageId       String?
  contentHash     String?
  manifest        Json
  staleAt         DateTime?
  taxYear         TaxYear         @relation(fields: [taxYearId], references: [id])
  calculationRun  CalculationRun  @relation(fields: [calculationRunId], references: [id])
  createdAt       DateTime        @default(now())
  @@index([taxYearId, formKey, createdAt])
}

model GeneratedReturnPackage {
  id               String         @id @default(uuid()) @db.Uuid
  taxYearId        String         @db.Uuid
  calculationRunId String         @db.Uuid
  status           String
  completeness     String
  storageId        String?
  contentHash      String?
  manifest         Json
  staleAt          DateTime?
  taxYear          TaxYear        @relation(fields: [taxYearId], references: [id])
  calculationRun   CalculationRun @relation(fields: [calculationRunId], references: [id])
  createdAt        DateTime       @default(now())
}

model WorkpaperRun {
  id               String         @id @default(uuid()) @db.Uuid
  taxYearId        String         @db.Uuid
  calculationRunId String         @db.Uuid
  status           String
  storageId        String?
  contentHash      String?
  manifest         Json
  staleAt          DateTime?
  taxYear          TaxYear        @relation(fields: [taxYearId], references: [id])
  calculationRun   CalculationRun @relation(fields: [calculationRunId], references: [id])
  createdAt        DateTime       @default(now())
}

model IntegrationConnection {
  id           String   @id @default(uuid()) @db.Uuid
  firmId       String   @db.Uuid
  vendor       String
  status       String
  capabilities Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([firmId, vendor])
}

model IntegrationSyncRun {
  id              String   @id @default(uuid()) @db.Uuid
  connectionId    String   @db.Uuid
  taxYearId       String   @db.Uuid
  direction       String
  status          String
  previewManifest Json
  createdAt       DateTime @default(now())
  completedAt     DateTime?
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  taxYearId  String?  @db.Uuid
  actorId    String   @db.Uuid
  eventType  String
  recordType String
  recordId   String
  metadata   Json
  prevHash   String?
  eventHash  String
  taxYear    TaxYear? @relation(fields: [taxYearId], references: [id])
  actor      User     @relation(fields: [actorId], references: [id])
  createdAt  DateTime @default(now())
  @@index([taxYearId, createdAt])
}
