# Nexus production environment for Hostinger Business Web Hosting.
#
# Copy each name into Hostinger hPanel's environment-variable editor.
# Never commit a populated copy. Do not reuse encryption keys or tokens.

APP_ENV="production"

# Prefer the Supabase Session Pooler URL when Hostinger cannot reach the
# project's direct IPv6 database endpoint. URL-encode special password characters.
DATABASE_URL="postgresql://<user>:<url-encoded-password>@<supabase-session-pooler-host>:5432/postgres?sslmode=require"

# Generate independently with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="<base64-encoded-32-byte-key>"
NEXUS_AUTH_FLOW_KEY="<base64-encoded-32-byte-key>"
NEXUS_SOURCE_ENCRYPTION_KEY="<base64-encoded-32-byte-key>"

# Generate independently with: openssl rand -hex 32
AUTH_RATE_LIMIT_SECRET="<at-least-32-random-characters>"

# Supabase project settings. Publishable keys are safe for browser use, but a
# Supabase service-role key must never be entered in any NEXT_PUBLIC variable.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<supabase-publishable-key>"
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<same-supabase-publishable-key>"

# Replace <production-domain> after attaching the domain in Hostinger, then add
# this exact URL to the Supabase Auth redirect allowlist.
NEXUS_AUTH_RECOVERY_REDIRECT_URL="https://<production-domain>/auth/recovery/confirm"
NEXUS_TRUSTED_NETWORK_HEADER="x-real-ip"

# Optional for a single-firm pilot; otherwise leave empty.
NEXUS_AUTH_DEFAULT_FIRM_ID=""

# Approved HTTPS malware-scanning service used for all production uploads.
NEXUS_MALWARE_SCANNER_URL="https://<scanner-host>/v1/scan"
NEXUS_MALWARE_SCANNER_TOKEN="<at-least-32-random-characters>"

# Accountable owners and controlled approval/evidence references. Do not put
# taxpayer data, passwords, access tokens, or other credentials in these fields.
NEXUS_MONITORING_PROVIDER="<provider-name>"
NEXUS_INCIDENT_OWNER="<owner-name-or-team>"
NEXUS_SECURITY_OWNER="<owner-name-or-team>"
NEXUS_PRODUCT_OWNER="<owner-name-or-team>"
NEXUS_SCOPE_APPROVAL_REF="<controlled-record-reference>"
NEXUS_TAX_RULE_OWNER="<qualified-owner-name-or-team>"
NEXUS_TAX_RULE_APPROVAL_REF="<controlled-record-reference>"
NEXUS_RETENTION_POLICY_REF="<controlled-record-reference>"
NEXUS_PRODUCTION_DATA_AUTHORIZATION_REF="<controlled-record-reference>"

# Backup objectives enforced by the production-readiness gate.
NEXUS_BACKUP_PROVIDER="<provider-name>"
NEXUS_BACKUP_RPO_MINUTES="60"
NEXUS_BACKUP_RTO_MINUTES="240"
NEXUS_BACKUP_RESTORE_EVIDENCE_REF="<controlled-record-reference>"
